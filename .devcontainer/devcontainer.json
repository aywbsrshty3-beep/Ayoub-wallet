{
  "name": "Ayoub Wallet Dev Environment",
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "lts"
    }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "eamodio.gitlens"
      ]
    }
  },

  // اجرای خودکار نصب وابستگی‌ها پس از ساخت کانتینر
  "postCreateCommand": "npm install",

  // باز کردن پورت 3000 برای دسترسی به برنامه در مرورگر سیستم خودت
  "forwardPorts": [3000],

  "remoteUser": "vscode"
}
